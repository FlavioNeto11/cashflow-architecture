    <Compile Include="..\CashFlow.Consolidation.Tests\Support\MetricCapture.cs" Link="Support\MetricCapture.cs" />
    <Compile Include="..\CashFlow.Consolidation.Tests\Support\Eventually.cs" Link="Support\Eventually.cs" />
  </ItemGroup>

</Project>
