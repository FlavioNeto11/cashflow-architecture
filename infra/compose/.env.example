# Valores de DESENVOLVIMENTO LOCAL, obvios e sem valor fora desta maquina.
# Copie para infra/compose/.env (ignorado pelo Git: .gitignore ignora ".env" e ".env.*", exceto ".env.example").
# As senhas dos papeis so valem na primeira criacao do volume do postgres (veja infra/README.md).

POSTGRES_PASSWORD=dev_postgres_superuser_pw
MIGRATOR_PASSWORD=dev_migrator_pw
TX_APP_PASSWORD=dev_tx_app_pw
CONS_RO_PASSWORD=dev_cons_ro_pw
CONS_WORKER_PASSWORD=dev_cons_worker_pw
RECON_RO_PASSWORD=dev_recon_ro_pw
RECON_WRITER_PASSWORD=dev_recon_writer_pw

RABBITMQ_DEFAULT_USER=dev_rabbit
RABBITMQ_DEFAULT_PASS=dev_rabbit_pw
# Usuario de OPERACAO do RabbitMQ (tag administrator; UI em http://127.0.0.1:15672 e rabbitmqctl). Distinto do usuario da
# aplicacao acima, que nao tem tag. Opcional: POR PADRAO NAO E CRIADO e a UI de gerenciamento fica sem login.
# Para habilitar, descomente e defina uma senha propria (nunca deixe um valor de exemplo):
# RABBITMQ_OPS_USER=cashflow_ops
# RABBITMQ_OPS_PASS=

KEYCLOAK_ADMIN=dev_kc_admin
KEYCLOAK_ADMIN_PASSWORD=dev_kc_admin_pw

# F5: aplicados pelo servico one-shot keycloak-init APOS o import do realm (o Keycloak nao substitui ${env.*} no JSON).
# Secrets dos clientes confidenciais (Client Credentials) e senha dos usuarios demo-a/demo-b (cashflow-web, PKCE).
KEYCLOAK_MERCHANT_A_SYSTEM_SECRET=dev_merchant_a_system_secret
KEYCLOAK_MERCHANT_B_SYSTEM_SECRET=dev_merchant_b_system_secret
KEYCLOAK_DEMO_USER_PASSWORD=dev_demo_user_pw
