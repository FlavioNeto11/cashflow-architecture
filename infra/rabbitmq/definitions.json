{
  "rabbitmq_version": "4.4.0",
  "vhosts": [
    { "name": "/" }
  ],
  "exchanges": [
    {
      "name": "cashflow.transactions",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "cashflow.dlx",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "consolidation.transaction-registered",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 5,
        "x-dead-letter-exchange": "cashflow.dlx",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "consolidation.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic"
      }
    }
  ],
  "bindings": [
    {
      "source": "cashflow.transactions",
      "vhost": "/",
      "destination": "consolidation.transaction-registered",
      "destination_type": "queue",
      "routing_key": "transaction.registered.v1",
      "arguments": {}
    },
    {
      "source": "cashflow.dlx",
      "vhost": "/",
      "destination": "consolidation.dlq",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
  ]
}
