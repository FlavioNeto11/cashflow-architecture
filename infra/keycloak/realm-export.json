      "enabled": true,
      "emailVerified": true,
      "email": "demo-b@example.invalid",
      "firstName": "Demo",
      "lastName": "Merchant B",
      "attributes": { "merchant_id": ["44444444-4444-4444-8444-444444444444"] },
      "requiredActions": [],
